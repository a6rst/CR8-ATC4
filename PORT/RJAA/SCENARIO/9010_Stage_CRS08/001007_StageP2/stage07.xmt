<!-- ====================================================
	EVT : DELIVERY CEREMONY (OBJECTIVE)
========================================================= -->
	<Category name="CR8_EV_DELIVERY_MASTER">
	<!-- CLEARFLAG -->
		<Effect trigger="start" overlap="once">
			<Flag iFlag1="0"/>
			<!--Flag clearflag2="1"/-->
		</Effect>
	<!-- CAR MODEL IMPORT -->
		<Effect trigger="start" overlap="once">
			<Model file="CR8_blockade\others\ceremony05" pos="-710.372,0,649.938" rotate="0,59.5,0">
			<!-- FIRETRUCK SPAWN -->
				<Wait iFlag1="@EQ:1"/>
				<Wait time="2000"/>
				<Action para="33,1"/>
			<!-- WATER SALUTE START -->
				<Wait iFlag1="@EQ:2"/>
				<Action para="7,1" time="0"/>
			<!-- WATER SALUTE STOP -->
				<Wait iFlag1="@EQ:3"/>
				<Action para="21,1"/>
			<!-- DISAPPEAR AFTER CEREMONY -->
				<Wait time="120000"/>
				<!--Action para="25,0"/-->
				<Action para="33,0"/>
			</Model>
		</Effect>
	</Category>
<!-- ====================================================
	EVT : DELIVERY CEREMONY (AIRCRAFT)
========================================================= -->
	<Category callsign="TBA8107" name="CR8_EV_DELIVERY_CHECK">	
		<!-- FIRETRUCK SPAWN -->
		<Effect trigger="touchdown" overlap="once">
			<Wait time="25000"/>
			<Flag iFlag1="1"/>
		</Effect>
		<!-- WATER SALUTE START -->
		<Effect comstate="CR8_EV_DELIVERY_INITIAL" overlap="once">
			<Flag iFlag1="2"/>
		</Effect>
		<!-- WATER SALUTE STOP -->
		<Effect comstate="CR8_EV_DELIVERY_END" overlap="once">
			<Flag iFlag1="3"/>
		</Effect>
			<!-- yes I did try to use nodetrack for these and they didn't work for some reason????? -->
			<!-- so y'all enjoy the standard event-subcode sequence instead -->
